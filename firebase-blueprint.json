{
  "entities": {
    "RegisteredPhone": {
      "title": "RegisteredPhone",
      "description": "Secure device registration linked to verified owner account",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "imei": { "type": "string", "pattern": "^[0-9]{15}$" },
        "ownerPhone": { "type": "string", "maxLength": 30 },
        "ownerEmail": { "type": "string", "format": "email" },
        "deviceModel": { "type": "string", "maxLength": 100 },
        "carrier": { "type": "string", "maxLength": 60 },
        "protectionEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "accuracy": { "type": "number" },
            "timestamp": { "type": "string" },
            "address": { "type": "string" },
            "batteryLevel": { "type": "number" }
          }
        },
        "lastLocationUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "imei", "ownerPhone", "ownerEmail", "deviceModel", "protectionEnabled"]
    },
    "User": {
      "title": "User",
      "description": "User profile with contact info and location",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/registeredPhones/{deviceId}": {
      "schema": "RegisteredPhone",
      "description": "Registered devices with owner credentials and location telemetry"
    },
    "/registeredPhones/{deviceId}/locationHistory/{historyId}": {
      "schema": {
        "type": "object",
        "properties": {
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "accuracy": { "type": "number" },
          "timestamp": { "type": "string", "format": "date-time" },
          "batteryLevel": { "type": "number" }
        },
        "required": ["lat", "lng", "accuracy"]
      },
      "description": "Historical GPS location records for authorized recovery"
    }
  }
}
