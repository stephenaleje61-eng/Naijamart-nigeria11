rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. NaijaBusiness Profiles
    // Publicly readable for public browsing (NO LOGIN WALL)
    // Only registered owners can create/update their profile
    match /businessProfiles/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      
      // Business Reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      }
    }

    // Product Listings under NaijaBusiness
    match /productListings/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // 2. FarmLink Africa Listings
    // Direct farm-to-buyer: read by anyone nationwide, created by verified farmers/merchants
    match /farmListings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.farmerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.farmerUid == request.auth.uid;
    }

    // 3. SkillBridge Africa: Job Listings
    match /jobListings/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.employerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.employerUid == request.auth.uid;
    }

    // Freelancer Profiles
    match /freelancerProfiles/{freelancerId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == freelancerId || request.resource.data.uid == request.auth.uid);
      allow delete: if isAuthenticated() && (request.auth.uid == freelancerId || resource.data.uid == request.auth.uid);
    }

    // Job Applications (Private between applicant and job owner)
    match /jobApplications/{appId} {
      allow read: if isAuthenticated() && (resource.data.applicantUid == request.auth.uid || resource.data.employerUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.applicantUid == request.auth.uid;
    }

    // 4. SolveAI Learning Sessions
    match /learningSessions/{sessionId} {
      allow read: if true; // Public practice questions & labs
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userUid == request.auth.uid;
    }

    // NaijaMart Hub & Real Spaces compatibility
    match /spaces/{spaceId}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
    }

    match /rideRequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /friends/{friendId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /privateChats/{roomId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
  }
}
